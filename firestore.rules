rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /config/final {
      allow read: if true;
      allow write: if false;
    }

    match /scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name','attempts','ms','date','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24
        && request.resource.data.attempts is int
        && request.resource.data.attempts >= 14 && request.resource.data.attempts <= 1000
        && request.resource.data.ms is int
        && request.resource.data.ms >= 5000
        && request.resource.data.date is string && request.resource.data.date.size() <= 40
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
